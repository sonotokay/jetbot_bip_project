<launch>
  <!-- Argument to control IMU usage -->
  <arg name="use_imu" default="true" />

  <!-- Kalman filter node -->
  <node pkg="jetbot_project"
        type="filter.py"
        name="kalman_filter_node"
        output="screen"
        respawn="true"
        if="$(arg use_imu)">

    <!-- Input/output topics -->
    <param name="input_topic" value="/imu" />
    <param name="output_topic" value="/kalman_imu" />

    <!-- Default noise parameters -->
    <param name="default_gyro_var" value="0.005" />
    <param name="default_accel_var" value="0.05" />
  </node>
</launch>
